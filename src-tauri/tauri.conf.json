{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "anilume",
  "version": "0.3.3",
  "identifier": "dev.mekka.anilume",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "anilume",
        "width": 1380,
        "height": 880,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "dragDropEnabled": false,
        "trafficLightPosition": {
          "x": 19,
          "y": 23
        },
        "windowEffects": {
          "effects": [
            "sidebar",
            "mica"
          ],
          "state": "followsWindowActiveState",
          "radius": 12
        }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: https: http: asset: http://asset.localhost",
        "media-src": "'self' blob: http://127.0.0.1:* http://localhost:* asset: http://asset.localhost https://asset.localhost",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* asset: http://asset.localhost https://asset.localhost"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$VIDEO/**",
          "$HOME/Videos/**",
          "$HOME/Movies/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": [
      "app",
      "dmg",
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/anilume-sidecar",
      "binaries/ffmpeg"
    ],
    "resources": [],
    "copyright": "MIT",
    "category": "Entertainment",
    "shortDescription": "Клиент для просмотра аниме",
    "longDescription": "Десктоп-клиент для просмотра аниме с русской озвучкой: каталог, поиск, встроенный плеер, история просмотра, синхронизация с Shikimori и офлайн-загрузки.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "Russian",
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/mekkadev/anilume/releases/latest/download/latest.json"
      ],
      "pubkey": "ЗАМЕНИТЕ_НА_ПУБЛИЧНЫЙ_КЛЮЧ",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
